# Database: Postgres (local, Neon or Supabase). On Vercel, add Neon from the Storage tab and it fills these in.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smarthomekj"
# Non-pooled connection for schema changes (on Neon/Supabase: the "direct" URL). Locally, same as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/smarthomekj"

# Public URL of the site (used for Stripe redirects, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign admin sessions. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@smarthomekj.bg"
ADMIN_PASSWORD="ChangeMe123!"

# Support chat AI (optional). Without a key, the chat answers from the FAQ.
ANTHROPIC_API_KEY=""
CHAT_MODEL="claude-opus-5-5"

# Stripe card payments (optional). Without keys, only cash on delivery and bank transfer are offered.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (optional). Used for order confirmations, withdrawal receipts and team notifications.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SmartHomeKJ <hello@smarthomekj.bg>"
ADMIN_NOTIFY_EMAIL=""

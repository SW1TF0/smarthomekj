// SQLite for local development. For production switch provider to "postgresql"
// and point DATABASE_URL at your Postgres database, then run `npx prisma db push`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | EDITOR
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

// Key/value store for company details, shipping rules and chat behaviour.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Product {
  id           String      @id @default(cuid())
  slug         String      @unique
  sku          String      @unique
  category     String // lighting | climate | security | energy | entertainment | hubs
  priceCents   Int // gross price in euro cents, VAT included
  compareAtCents Int?
  stock        Int         @default(0)
  active       Boolean     @default(true)
  featured     Boolean     @default(false)
  imageUrl     String?
  // JSON: { bg: { name, tagline, description, specs: string[] }, en: {...}, tr: {...} }
  translations String
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  status          String      @default("PENDING") // PENDING | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentMethod   String // CARD | COD | BANK
  paymentStatus   String      @default("UNPAID") // UNPAID | PAID | REFUNDED
  stripeSessionId String?     @unique
  locale          String      @default("bg")
  email           String
  name            String
  phone           String
  address         String
  city            String
  postcode        String
  country         String      @default("BG")
  companyName     String?
  vatNumber       String?
  note            String?
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  vatCents        Int
  adminNotes      String?
  trackingNumber  String?
  termsAcceptedAt DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  sku        String
  priceCents Int
  quantity   Int
}

// Consultation / quote requests for installations.
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String
  propertyType String?
  message   String
  locale    String   @default("bg")
  status    String   @default("NEW") // NEW | CONTACTED | QUOTED | WON | LOST
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqEntry {
  id           String   @id @default(cuid())
  // JSON: { bg: { q, a }, en: { q, a }, tr: { q, a } }
  translations String
  keywords     String   @default("") // comma-separated words that help the chat match questions
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatConversation {
  id             String        @id @default(cuid())
  visitorId      String
  locale         String        @default("bg")
  mode           String        @default("BOT") // BOT | HUMAN | CLOSED
  visitorName    String?
  visitorEmail   String?
  unreadForAdmin Boolean       @default(true)
  lastMessageAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  messages       ChatMessage[]

  @@index([visitorId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER | BOT | ADMIN | SYSTEM
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// GDPR data subject requests (access, erasure, rectification, objection).
model PrivacyRequest {
  id        String   @id @default(cuid())
  type      String // ACCESS | ERASURE | RECTIFICATION | OBJECTION | PORTABILITY
  name      String
  email     String
  message   String?
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | DONE | REJECTED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Right of withdrawal for distance contracts (Directive 2011/83/EU, art. 11a withdrawal function).
model WithdrawalRequest {
  id          String   @id @default(cuid())
  orderNumber String
  name        String
  email       String
  items       String
  reason      String?
  status      String   @default("RECEIVED") // RECEIVED | APPROVED | REFUNDED | REJECTED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Proof of cookie consent (GDPR art. 7(1) accountability).
model ConsentRecord {
  id         String   @id @default(cuid())
  visitorId  String
  analytics  Boolean
  marketing  Boolean
  version    String
  userAgent  String?
  createdAt  DateTime @default(now())
}
